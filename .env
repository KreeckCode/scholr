SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False


SCHOLR_LMS_ENABLED=True
SCHOLR_ACADEMICS_ENABLED=True

# Enrollment module (off by default)
SCHOLR_ENROLLMENT_ENABLED=True

# Bursary sub-feature (off by default — most private schools don't offer it)
SCHOLR_BURSARY_ENABLED=False